    {
      "id": "legitimate_high_cardinality",
      "ticket": 58,
      "title": "Legitimate high-cardinality grouping column",
      "question": "Does spend differ across 12 cities?",
      "dataset": "datasets/high_cardinality_grouping.csv",
      "request": {
        "comparison_type": "categorical_numeric",
        "group_column": "city",
        "value_column": "spend"
      },
      "expected_status": 201,
      "expect": {
        "test.method.key": "kruskal_wallis",
        "test.status": "ok"
      },
      "expected_absent_keys": [
