{
  "rel_tolerance": 1e-06,
  "abs_tolerance": 1e-09,
  "cases": [
    {
      "id": "identifier_warning",
      "ticket": 58,
      "title": "Identifier-like grouping column",
      "question": "Is customer_id a meaningful grouping for spend?",
      "dataset": "datasets/identifier_like.csv",
      "request": {
        "comparison_type": "categorical_numeric",
        "group_column": "customer_id",
        "value_column": "spend"
      },
      "expected_status": 201,
      "expect": {
        "identifier_review.0.column": "customer_id",
        "identifier_review.0.likely_identifier": true,
        "identifier_review.0.confirmed": false,
        "identifier_review.0.signals.distinct_values": 40
      },
      "expected_warnings_contain": [
        "may be an identifier"
      ],
      "visual": "Warning beside the result with the reasons; no chart should be trusted until the user confirms.",
      "notes": "40 of 40 values are distinct. The existing category limit is unchanged."
    },
    {
      "id": "identifier_confirmed",
      "ticket": 58,
      "title": "User confirms the flagged column",
      "question": "Same selection, with customer_id confirmed as meaningful.",
      "dataset": "datasets/identifier_like.csv",
      "request": {
        "comparison_type": "categorical_numeric",
        "group_column": "customer_id",
        "value_column": "spend",
        "confirm_columns": [
          "customer_id"
        ]
      },
      "expected_status": 201,
      "expect": {
        "identifier_review.0.confirmed": true
      },
      "expected_absent_warnings": [
        "may be an identifier"
      ],
      "visual": "The reasons stay visible and show as confirmed.",
      "notes": "Confirmation removes the warning but keeps the reasons on record."
    },
    {
