      ],
      "visual": "Grouped summary of 12 cities.",
      "notes": "12 distinct values in 120 rows (10%) is not flagged."
    },
    {
      "id": "sparse_comparison",
      "ticket": 58,
      "title": "Sparse categorical comparison",
      "question": "Is income distributed differently across education levels?",
      "dataset": "datasets/sparse_categories.csv",
      "request": {
        "comparison_type": "categorical_categorical",
        "group_column": "education",
        "outcome_column": "income"
      },
      "expected_status": 201,
      "expect": {
        "test.statistic": 11.76,
        "test.p_value": 0.008252191253966895,
        "test.degrees_of_freedom": 3,
        "test.expected_count_summary.cells": 8,
        "test.expected_count_summary.cells_below_5": 4
      },
      "expected_warnings_contain": [
        "expected counts below 5"
      ],
      "visual": "Grouped percentage bars; MA and PhD have 3 and 2 rows.",
      "notes": "No regrouping: the baseline."
    },
    {
      "id": "valid_combination",
      "ticket": 58,
      "title": "Valid user-defined combination",
      "question": "Is income distributed differently for HS versus a combined Degree group (BA, MA, PhD)?",
      "dataset": "datasets/sparse_categories.csv",
      "request": {
        "comparison_type": "categorical_categorical",
        "group_column": "education",
        "outcome_column": "income",
        "category_mappings": {
          "education": [
            {
              "label": "Degree",
              "categories": [
                "BA",
                "MA",
                "PhD"
              ]
            }
          ]
        }
      },
      "expected_status": 201,
      "expect": {
        "test.statistic": 9.6,
        "test.p_value": 0.0019457736937391556,
        "test.degrees_of_freedom": 1,
        "test.expected_count_summary.cells": 4,
        "test.expected_count_summary.cells_below_5": 0,
        "regrouping.columns.0.categories_before": 4,
        "regrouping.columns.0.categories_after": 2,
        "regrouping.columns.0.rows_relabelled": 30,
        "regrouping.method_change.changed": false
      },
      "expect_counts": {
        "before": [
          {
            "label": "HS",
            "count": 30
          },
          {
            "label": "BA",
            "count": 25
          },
          {
            "label": "MA",
            "count": 3
          },
          {
            "label": "PhD",
            "count": 2
          }
        ],
        "after": [
          {
            "label": "Degree",
            "count": 30
          },
          {
            "label": "HS",
            "count": 30
          }
        ]
      },
      "expect_mapping": {
        "education": [
          {
            "label": "Degree",
            "categories": [
              "BA",
              "MA",
              "PhD"
            ]
          }
        ]
      },
      "expected_warnings_contain": [],
      "expected_absent_warnings": [
        "expected counts below 5"
      ],
      "visual": "Before/after category-count bar chart.",
      "notes": "Four groups become two. The mapping, original counts and regrouped counts are returned. A different p-value is not evidence the regrouping is better."
    },
    {
      "id": "regrouped_with_remaining_warnings",
      "ticket": 58,
      "title": "Regrouped comparison that still has reliability warnings",
      "question": "Is income distributed differently once only MA and PhD are combined into Graduate?",
      "dataset": "datasets/sparse_categories.csv",
      "request": {
        "comparison_type": "categorical_categorical",
        "group_column": "education",
        "outcome_column": "income",
        "category_mappings": {
          "education": [
            {
              "label": "Graduate",
              "categories": [
                "MA",
                "PhD"
              ]
            }
          ]
        }
      },
      "expected_status": 201,
      "expect": {
        "test.statistic": 11.76,
        "test.p_value": 0.002794785275036845,
        "test.degrees_of_freedom": 2,
        "test.expected_count_summary.cells": 6,
        "test.expected_count_summary.cells_below_5": 2,
        "regrouping.columns.0.categories_before": 4,
        "regrouping.columns.0.categories_after": 3,
        "regrouping.columns.0.rows_relabelled": 5,
        "regrouping.method_change.changed": false
      },
      "expect_counts": {
        "before": [
          {
            "label": "HS",
            "count": 30
          },
          {
            "label": "BA",
            "count": 25
          },
          {
            "label": "MA",
            "count": 3
          },
          {
            "label": "PhD",
            "count": 2
          }
        ],
        "after": [
          {
            "label": "HS",
            "count": 30
          },
          {
            "label": "BA",
            "count": 25
          },
          {
            "label": "Graduate",
            "count": 5
          }
        ]
      },
      "expect_mapping": {
        "education": [
          {
            "label": "Graduate",
            "categories": [
              "MA",
              "PhD"
            ]
          }
        ]
      },
      "expected_warnings_contain": [
        "expected counts below 5"
      ],
      "expected_absent_warnings": [],
      "visual": "Before/after counts; the remaining warning stays beside the chart.",
      "notes": "Graduate has only 5 rows, so expected counts are still small. The warning is not hidden by regrouping."
    },
    {
      "id": "method_changes",
      "ticket": 58,
      "title": "Combination that changes the number of groups and the method",
      "question": "Does age differ by education when everyone above high school is combined?",
      "dataset": "datasets/sparse_categories.csv",
      "request": {
        "comparison_type": "categorical_numeric",
        "group_column": "education",
        "value_column": "age",
        "category_mappings": {
          "education": [
            {
              "label": "Degree",
              "categories": [
                "BA",
                "MA",
                "PhD"
              ]
            }
          ]
        }
      },
      "expected_status": 201,
      "expect": {
        "regrouping.method_change.group_count_before": 4,
        "regrouping.method_change.group_count_after": 2,
        "regrouping.method_change.method_before": "kruskal_wallis",
        "regrouping.method_change.method_after": "welch_t_test",
        "regrouping.method_change.changed": true,
        "test.method.key": "welch_t_test"
      },
      "visual": "Before/after counts plus a notice that the method changed from a rank to a mean comparison.",
      "notes": "Four groups use Kruskal-Wallis; two groups use Welch's t-test."
    },
    {
      "id": "regroup_both_columns",
      "ticket": 58,
      "title": "Regroup the group and the outcome column",
      "question": "Mappings can be given for both categorical columns of a categorical comparison.",
      "dataset": "datasets/sparse_categories.csv",
      "request": {
        "comparison_type": "categorical_categorical",
        "group_column": "education",
        "outcome_column": "income",
        "category_mappings": {
          "education": [
            {
              "label": "Degree",
              "categories": [
                "BA",
                "MA",
                "PhD"
              ]
            }
          ],
          "income": [
            {
              "label": "below",
              "categories": [
                "low"
              ]
            }
          ]
        }
      },
      "expected_status": 201,
      "expect": {
        "regrouping.columns.0.column": "education",
        "regrouping.columns.1.column": "income",
        "regrouping.columns.1.categories_after": 2
      },
      "visual": "Before/after charts for both columns.",
      "notes": "Renaming a single category is allowed. Unmapped categories keep their labels."
    },
